{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter (Dev Mode)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      // Passes a compiler argument to separate your environments in code
      "args": [
        "--dart-define=ENVIRONMENT=dev"
      ]
    },
    {
      "name": "Flutter (Staging)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "args": [
        "--dart-define=ENVIRONMENT=staging"
      ]
    },
    {
      "name": "Flutter (Production)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      // Runs in release mode to test actual app performance
      "args": [
        "--dart-define=ENVIRONMENT=prod"
      ]
    },
    {
      "name": "Flutter (Web Dev)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      // Forces the web app to run on a consistent port
      "args": [
        "--web-port", "8080",
        "--dart-define=ENVIRONMENT=dev"
      ]
    }
  ]
}
